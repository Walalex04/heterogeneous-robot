<?xml version='1.0' encoding='utf-8'?>
<argos-configuration>
  <framework>
    <experiment length="1000000" ticks_per_second="10" random_seed="1" />
    <system threads="2" />
  </framework>
  <controllers>
    <lua_controller id="qupa_SoSN_lua">
      <actuators>
       
        <differential_steering implementation="default" />
        <leds implementation="default" medium="leds" />
        <range_and_bearing implementation="default" />
      </actuators>
      <sensors>
        <positioning implementation="default" />
        <range_and_bearing implementation="medium" medium="rab" />
      </sensors>
      <params script="../../controllers/UGV/qupa_controller.lua" />
    </lua_controller>
    <lua_controller id="crazyflie_SoSN_lua">
      <actuators>
        <quadrotor_speed implementation="default" />
        <leds implementation="default" medium="leds" />
        <range_and_bearing implementation="default" />
      </actuators>
      <sensors>
        <positioning implementation="default" />
        <range_and_bearing implementation="medium" medium="rab" />
        <crazyflie_apriltag implementation="default" tag_medium="tags" range="3.0" fov="110" show_rays="true" show_fov="true" />

      </sensors>
      <params script="../../controllers/UAV/crazyflie_controller.lua" />
    </lua_controller>
  </controllers>
  <arena size="7,7,3" center="0,0,0">
    <floor id="floor" source="image" path="../resources/floor.png" pixels_per_meter="100" />

    <distribute>
      <position method="uniform" min="-2.5, -2.5, 0.5" max="2.5, 2.5, 1.5" />
      <orientation method="gaussian" mean="0,0,0" std_dev="360,0,0"/>
      <entity quantity="3" max_trials="100"> 
          <crazyflie id="cf" rab_range="3.0" rab_data_size="16">
            <crazyflie_battery start_charge="1.0" />
            <controller config="crazyflie_SoSN_lua" />
          </crazyflie>
      </entity>
    </distribute>
  
    <qupa id="q101" marker_id="101" tag_medium="tags" rab_range="3.0" rab_data_size="16">
      <body position="-2.1, 1.8, 0" orientation="45,0,0" />
      <controller config="qupa_SoSN_lua" />
    </qupa>
    <qupa id="q102" marker_id="102" tag_medium="tags" rab_range="3.0" rab_data_size="16">
      <body position="1.4, -2.3, 0" orientation="120,0,0" />
      <controller config="qupa_SoSN_lua" />
    </qupa>
    <qupa id="q103" marker_id="103" tag_medium="tags" rab_range="3.0" rab_data_size="16">
      <body position="-0.8, -1.9, 0" orientation="-30,0,0" />
      <controller config="qupa_SoSN_lua" />
    </qupa>
    <qupa id="q104" marker_id="104" tag_medium="tags" rab_range="3.0" rab_data_size="16">
      <body position="2.5, 0.9, 0" orientation="210,0,0" />
      <controller config="qupa_SoSN_lua" />
    </qupa>
    <qupa id="q105" marker_id="105" tag_medium="tags" rab_range="3.0" rab_data_size="16">
      <body position="-2.6, -0.7, 0" orientation="90,0,0" />
      <controller config="qupa_SoSN_lua" />
    </qupa>
    <qupa id="q106" marker_id="106" tag_medium="tags" rab_range="3.0" rab_data_size="16">
      <body position="0.3, 2.7, 0" orientation="-135,0,0" />
      <controller config="qupa_SoSN_lua" />
    </qupa>
    <qupa id="q107" marker_id="107" tag_medium="tags" rab_range="3.0" rab_data_size="16">
      <body position="1.9, 2.1, 0" orientation="15,0,0" />
      <controller config="qupa_SoSN_lua" />
    </qupa>
    <qupa id="q108" marker_id="108" tag_medium="tags" rab_range="3.0" rab_data_size="16">
      <body position="-1.2, 0.6, 0" orientation="-80,0,0" />
      <controller config="qupa_SoSN_lua" />
    </qupa>
    <qupa id="q109" marker_id="109" tag_medium="tags" rab_range="3.0" rab_data_size="16">
      <body position="0.1, -0.4, 0" orientation="160,0,0" />
      <controller config="qupa_SoSN_lua" />
    </qupa>
    <qupa id="q110" marker_id="110" tag_medium="tags" rab_range="3.0" rab_data_size="16">
      <body position="-1.9, -2.5, 0" orientation="60,0,0" />
      <controller config="qupa_SoSN_lua" />
    </qupa>
  </arena>
  <physics_engines>
    <pointmass3d id="pm3d" iterations="10" />
  </physics_engines>
  <media>
    <tag id="tags" index="grid" grid_size="5,5,5" />
    <led id="leds" index="grid" grid_size="40,40,4" />
    <range_and_bearing id="rab" index="grid" grid_size="1,1,1" />
  </media>
  <visualization>
    <qt-opengl lua_editor="true">
      <camera>
        <placement idx="0" position="0,-6,5" look_at="0,0,0.5" up="0,0,1" lens_focal_length="35" />
      </camera>
    </qt-opengl>
  </visualization>
</argos-configuration>
